{
  "name": "@dweb/desktop",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "predev": "node ../../scripts/run-obscur-dev-clean.mjs && node ../../scripts/cleanup-tauri-sidecars.mjs && node ../../scripts/repair-tauri-permission-cache.mjs && node ../../scripts/setup-tor.mjs",
    "repair": "node ../../scripts/repair-tauri-permission-cache.mjs --force",
    "dev": "node ../../scripts/run-desktop-production.mjs dev",
    "dev:live": "node ../../scripts/run-tauri-with-build-temp.mjs dev --config src-tauri/tauri.live.dev.conf.json",
    "dev:vite-lab": "node ../../scripts/run-tauri-with-build-temp.mjs dev --config src-tauri/tauri.vite.lab.conf.json",
    "dev:lab": "node ../../scripts/dev-desktop-lab.mjs --lab",
    "dev:next": "node ../../scripts/run-tauri-with-build-temp.mjs dev --config src-tauri/tauri.dev.conf.json",
    "build:vite-lab": "node ../../scripts/run-tauri-with-build-temp.mjs build --config src-tauri/tauri.vite.lab.conf.json",
    "prebuild": "node ../../scripts/run-obscur-dev-clean.mjs && node ../../scripts/cleanup-tauri-sidecars.mjs && node ../../scripts/setup-tor.mjs",
    "build:pwa-shell": "node scripts/run-build-pwa-shell.mjs",
    "build": "node ../../scripts/run-desktop-production.mjs build",
    "build:next": "node ../../scripts/run-tauri-with-build-temp.mjs build --config src-tauri/tauri.next.rollback.conf.json",
    "build:android:debug": "node scripts/run-android-build.mjs --apk --debug",
    "build:android:debug:emulator": "cross-env GRADLE_ABI_LIST=x86_64 node scripts/run-android-build.mjs --apk --debug",
    "build:android:release": "node scripts/run-android-build.mjs --apk --aab"
  },
  "dependencies": {
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.5.9"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "cross-env": "^10.1.0"
  }
}
